{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cy-notion-site",
  "main": "src/index.js",
  "compatibility_date": "2024-09-23",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "logs": {
      "enabled": true
    }
  }
}
